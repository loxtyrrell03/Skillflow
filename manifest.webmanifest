{
  "id": "/",
  "name": "Skillflow",
  "short_name": "Skillflow",
  "description": "Structure focused practice sessions with timed sections, saved outlines, and section-end alerts.",
  "start_url": "/#home",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#f3f8ff",
